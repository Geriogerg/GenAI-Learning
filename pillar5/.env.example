# Copy to .env (in this folder) to override settings. Never commit .env.
# GROQ_API_KEY is usually already in d:\pythoncode\.env

# comma-separated, one key per client app
API_KEYS=dev-key-123
RATE_LIMIT_PER_MINUTE=30
MODEL_BIG=openai/gpt-oss-120b
MODEL_SMALL=openai/gpt-oss-20b
SEMANTIC_CACHE_THRESHOLD=0.95
GUARDRAILS=1
# 1 = offline answers, for load tests without spending quota
FAKE_LLM=0
